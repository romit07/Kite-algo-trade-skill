[Unit]
Description=Kite educational starter (FastAPI / Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiteapp
Group=kiteapp
WorkingDirectory=/opt/kite-starter
EnvironmentFile=/etc/kite-starter.env
Environment=PYTHONPATH=/opt/kite-starter/src
ExecStart=/opt/kite-starter/.venv/bin/uvicorn kite_starter.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
