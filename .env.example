# Copy to ".env" and fill locally — never commit ".env".
# Placeholders only; replace with your own values.

# --- Kite Connect (from https://developers.kite.trade/) ---
KITE_API_KEY=YOUR_API_KEY
KITE_API_SECRET=YOUR_API_SECRET

# Redirect must match your Kite app settings (example path)
KITE_REDIRECT_URL=http://127.0.0.1:8000/callback/kite

# Optional: override default Kite login URL (include v=3 per current docs)
# KITE_LOGIN_URL=https://kite.zerodha.com/connect/login?api_key=YOUR_API_KEY&v=3

# --- Zerodha account + TOTP (for manual or scripted login flows; never commit) ---
ZERODHA_USER_ID=YOUR_USER_ID
ZERODHA_PASSWORD=YOUR_PASSWORD
KITE_TOTP_SECRET=YOUR_BASE32_TOTP_SECRET

# --- Trading mode: paper is default; live requires explicit flags ---
PAPER_TRADING=true
ENABLE_LIVE_ORDERS=false

# --- Risk controls ---
MAX_DAILY_LOSS_INR=5000
MAX_ORDERS_PER_DAY=20
MAX_ORDER_QUANTITY=1
KILL_SWITCH_PATH=/tmp/kite-starter-kill-switch

# Prefix for order tags (mass cancel / square-off only touches orders with this tag prefix)
ORDER_TAG_PREFIX=ks

# When MARKET is rejected, retry as LIMIT at LTP ± this percent (buffer for protection)
MARKET_FALLBACK_LIMIT_BUFFER_PCT=0.15
ORDER_POLL_INTERVAL_SEC=0.5
ORDER_POLL_MAX_WAIT_SEC=45
NETWORK_RETRY_ATTEMPTS=2
NETWORK_RETRY_DELAY_SEC=0.75

# Optional: set to the same random string as in Kite developer postback URL query (?secret=)
# KITE_POSTBACK_SECRET=your_random_shared_secret

# --- Dashboard (HTTP Basic Auth behind HTTPS in production) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_this_to_a_long_random_secret

# --- App ---
DATABASE_PATH=./data/kite_starter.db
HOST=127.0.0.1
PORT=8000

# --- Demo strategy (educational; not tuned for profitability) ---
STRATEGY_INSTRUMENT_TOKEN=256265
STRATEGY_EXCHANGE=NSE
STRATEGY_TRADINGSYMBOL=NIFTY 50
STRATEGY_PRODUCT=MIS
STRATEGY_ORDER_QUANTITY=1
STRATEGY_BAR_INTERVAL=day
EMA_FAST=9
EMA_SLOW=21
